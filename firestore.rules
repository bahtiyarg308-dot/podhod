rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // the owner allowed this reader to see their workouts (created when partners connect)
    function sharedWithMe(owner) {
      return signedIn() && exists(/databases/$(database)/documents/links/$(owner + '_' + request.auth.uid));
    }

    // private: full profile, supplements, settings — only the owner, on any of their phones
    match /users/{uid}/pv/{doc} {
      allow read, write: if isMe(uid);
    }
    // public card, chat and workouts — the owner and connected partners
    match /users/{uid}/pb/{doc} {
      allow read: if isMe(uid) || sharedWithMe(uid);
      allow write: if isMe(uid);
    }
    match /users/{uid}/w/{doc} {
      allow read: if isMe(uid) || sharedWithMe(uid);
      allow write: if isMe(uid);
    }

    // invite codes: anyone signed in can check one code, nobody can list them or take over someone else's
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && code.size() >= 10;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // links/{owner}_{reader}: the owner shares with the reader
    match /links/{id} {
      allow get: if signedIn() && (resource == null || resource.data.owner == request.auth.uid || resource.data.reader == request.auth.uid);
      allow list: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.reader == request.auth.uid);
      allow create: if signedIn()
        && id == request.resource.data.owner + '_' + request.resource.data.reader
        && request.resource.data.owner != request.resource.data.reader
        && (request.resource.data.owner == request.auth.uid
          || (request.resource.data.reader == request.auth.uid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.uid == request.resource.data.owner
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.exp > request.time.toMillis()));
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || resource.data.reader == request.auth.uid);
    }
  }
}
